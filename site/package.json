    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
